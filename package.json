{
  "name": "imose-crm",
  "version": "1.0.0",
  "description": "IMOSE CRM desktop app for mobile phone repair business",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.imose.crm",
    "productName": "IMOSE CRM",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  }
}
